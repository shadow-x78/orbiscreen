# ─────────────────────────────────────────────
# Orbiscreen - Environment Variables
# ─────────────────────────────────────────────

# ── Logging & Diagnostics ──
ORBISCREEN_LOG=info
RUST_BACKTRACE=1

# ── Server & Streaming ──
ORBISCREEN_PORT=8788
ORBISCREEN_ENCODER=auto
ORBISCREEN_BITRATE_KBPS=8000

# ── Virtual Display Resolution ──
ORBISCREEN_DISPLAY_WIDTH=1920
ORBISCREEN_DISPLAY_HEIGHT=1080
ORBISCREEN_FRAMERATE=60

# ── Android Keystore Signing (Optional) ──
# ORBISCREEN_KEYSTORE_PATH=
# ORBISCREEN_STORE_PASSWORD=
# ORBISCREEN_KEY_ALIAS=
# ORBISCREEN_KEY_PASSWORD=
