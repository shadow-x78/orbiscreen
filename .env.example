# ─────────────────────────────────────────────
# Orbiscreen - Environment Variables
# https://github.com/shadow-x78/orbiscreen
# ─────────────────────────────────────────────

# Copy to `.env` (git-ignored) and set only what you need. Every ORBISCREEN_ variable
# listed under the daemon sections below is read by the host daemon; the signing ones are
# read by Gradle and the release workflows.

# ── Credentials ──

# Accept `?token=` in a query string. Needed by the web client, because a browser media
# request cannot carry an Authorization header. The trade-off: a credential in the URL can
# reach server logs, browser history and Referer headers. Set to 0 to refuse it.
ORBISCREEN_ALLOW_QUERY_TOKEN=1

# ── Client Assets ──

# Directory holding the web client served at /client. Falls back to the installed
# defaults when unset.
ORBISCREEN_CLIENT_DIR=

# ── Diagnostics ──

# Append raw Annex-B encoder output to this file for bitstream debugging.
ORBISCREEN_ENCODER_DUMP=

# Skip parking the virtual display when the last viewer disconnects.
ORBISCREEN_NO_PARK=

# ── UDP Tuning (test hooks) ──
# See docs/UDP_TRANSPORT.md for the full table.

# Upper bound of the PMTU search (clamped 576-65507).
ORBISCREEN_UDP_MAX_DATAGRAM=

# Pretend datagrams larger than this size were lost (PMTU test hook).
ORBISCREEN_UDP_DROP_ABOVE=

# Drop that percentage of outgoing datagrams, 0-90 (loss test hook).
ORBISCREEN_UDP_LOSS_PCT=

# Simultaneously tracked UDP clients, 1-64. Matches the HTTP and WebTransport stream cap.
ORBISCREEN_UDP_MAX_CLIENTS=8

# ── Packaging ──

# Set to 1 to make scripts/package-rpm.sh rebuild instead of reusing target/release.
ORBISCREEN_FORCE_REBUILD=0

# ── CI-only ──

# Set by the Android workflow, not by you: true when the pull request comes from a fork.
ORBISCREEN_FORK_PR=

# ── Android Keystore Signing ──
# Only required to build a signed release APK. See docs/PACKAGING.md.

ORBISCREEN_KEYSTORE_PATH=
ORBISCREEN_STORE_PASSWORD=
ORBISCREEN_KEY_ALIAS=
ORBISCREEN_KEY_PASSWORD=

# Base64-encoded keystore, used by the release workflows so the file never has to be
# written to the runner disk by hand.
ORBISCREEN_KEYSTORE_B64=

# ── Logging ──

RUST_LOG=info