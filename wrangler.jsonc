{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "orbiscreen-site",
  "main": "./worker/index.mjs",
  "compatibility_date": "2026-11-21",
  // Workers Builds can run the deploy command without a dashboard build
  // command. Wrangler then needs to build site/dist itself; otherwise the
  // assets directory does not exist and the build fails before it starts.
  "build": {
    "command": "test -d site/dist || npm run build",
    "cwd": "."
  },
  // The worker answers on orbiscreen.com and www.orbiscreen.com only. A
  // workers.dev address and preview URLs would serve the same pages from a
  // second, indexable host, which is exactly what the canonical host exists to
  // avoid.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./site/dist",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    // Without this the assets layer answers matching requests before the worker
    // runs, so the www redirect would never be reached. The worker is a thin
    // hostname check that hands everything else to ASSETS.
    "run_worker_first": true
  },
  "routes": [
    // The apex still carries the imported parking A record, and a custom domain
    // cannot attach over an externally managed record. A route takes over the
    // hostname instead: the record only has to exist and be proxied, which it is.
    { "pattern": "orbiscreen.com/*", "zone_name": "orbiscreen.com" },
    // www carries an imported record as well, so it is a route too. The worker
    // answers every request on it with the 301 to the apex.
    { "pattern": "www.orbiscreen.com/*", "zone_name": "orbiscreen.com" }
  ],
  "observability": {
    "enabled": true
  }
}