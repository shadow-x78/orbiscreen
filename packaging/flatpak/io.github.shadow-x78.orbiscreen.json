{
  "id": "io.github.shadow-x78.orbiscreen",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "command": "orbiscreen-service",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=x11",
    "--socket=wayland",
    "--device=dri",
    "--filesystem=/dev/uinput:rw",
    "--filesystem=xdg-run/pipewire-0",
    "--talk-name=org.freedesktop.portal.Desktop",
    "--talk-name=org.freedesktop.portal.Screencast",
    "--talk-name=org.freedesktop.portal.RemoteDesktop",
    "--own-name=com.orbiscreen.Daemon",
    "--system-talk-name=org.freedesktop.login1"
  ],
  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/orbiscreen/cargo",
      "NINJAJOBS": "4"
    }
  },
  "modules": [
    {
      "name": "orbiscreen",
      "buildsystem": "simple",
      "build-commands": [
        "cargo --offline build --release --bin orbiscreen",
        "install -Dm755 target/release/orbiscreen /app/bin/orbiscreen",
        "printf '#!/usr/bin/env bash\\nexec /app/bin/orbiscreen start \"$@\"\\n' > /app/bin/orbiscreen-service",
        "chmod 0755 /app/bin/orbiscreen-service",
        "install -Dm644 clients/web/index.html /app/share/orbiscreen/client/index.html",
        "install -Dm644 clients/web/style.css /app/share/orbiscreen/client/style.css",
        "install -Dm644 clients/web/app.js /app/share/orbiscreen/client/app.js",
        "install -Dm644 clients/web/vendor/mpegts.js /app/share/orbiscreen/client/vendor/mpegts.js",
        "install -Dm644 data/com.orbiscreen.OrbiscreenGtk.desktop /app/share/applications/io.github.shadow-x78.orbiscreen.desktop",
        "install -Dm644 data/orbiscreen.svg /app/share/icons/hicolor/scalable/apps/io.github.shadow-x78.orbiscreen.svg"
      ],
      "sources": [
        {
          "type": "dir",
          "path": "../.."
        },
        "generated-sources.json"
      ]
    }
  ]
}
