#!/usr/bin/make -f
# ─────────────────────────────────────────────
# Orbiscreen - Debian Package Rules
# https://github.com/shadow-x78/orbiscreen
# ─────────────────────────────────────────────

export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_configure:

override_dh_auto_build:
	if [ ! -x prebuilt/orbiscreen ] || [ ! -x prebuilt/orbiscreen-gui ]; then \
		cargo build --release --workspace --locked; \
		cmake -S gui -B build-gui -DCMAKE_BUILD_TYPE=Release; \
		cmake --build build-gui -j"$$(nproc)"; \
	fi

override_dh_auto_install:
	@mkdir -p debian/orbiscreen/usr/bin
	if [ -x prebuilt/orbiscreen ]; then \
		install -Dm0755 prebuilt/orbiscreen debian/orbiscreen/usr/bin/orbiscreen; \
		install -Dm0755 prebuilt/orbiscreen-gui debian/orbiscreen/usr/bin/orbiscreen-gui; \
	else \
		install -Dm0755 target/release/orbiscreen debian/orbiscreen/usr/bin/orbiscreen; \
		install -Dm0755 build-gui/orbiscreen-gui debian/orbiscreen/usr/bin/orbiscreen-gui; \
	fi
	install -Dm0644 data/orbiscreen.svg debian/orbiscreen/usr/share/icons/hicolor/scalable/apps/orbiscreen.svg
	ln -sf orbiscreen.svg debian/orbiscreen/usr/share/icons/hicolor/scalable/apps/orbiscreen-gui.svg
	for size in 16 22 24 32 48 64 128 256 512; do \
		if [ -f gui/icons/$${size}x$${size}.png ]; then \
			install -Dm0644 gui/icons/$${size}x$${size}.png debian/orbiscreen/usr/share/icons/hicolor/$${size}x$${size}/apps/orbiscreen.png; \
			ln -sf orbiscreen.png debian/orbiscreen/usr/share/icons/hicolor/$${size}x$${size}/apps/orbiscreen-gui.png; \
		fi \
	done
	install -Dm0644 data/orbiscreen.desktop debian/orbiscreen/usr/share/applications/orbiscreen.gui.desktop
	install -Dm0755 scripts/install-evdi-module.sh debian/orbiscreen/usr/share/orbiscreen/install-evdi-module.sh
	for f in index.html style.css app.js protocol.js annexb.js stats.js favicon.svg favicon.png apple-touch-icon.png; do \
		install -Dm0644 "clients/web/$$f" debian/orbiscreen/usr/share/orbiscreen/client/$$f; \
	done
	mkdir -p debian/orbiscreen/usr/share/orbiscreen/client/fonts
	install -m 0644 clients/web/fonts/*.ttf debian/orbiscreen/usr/share/orbiscreen/client/fonts/
	install -Dm0644 data/orbiscreen.service debian/orbiscreen/usr/lib/systemd/user/orbiscreen.service
	install -Dm0644 data/99-orbiscreen-usb.rules debian/orbiscreen/usr/lib/udev/rules.d/99-orbiscreen-usb.rules

override_dh_auto_test:
	if [ ! -x prebuilt/orbiscreen ]; then \
		cargo test --workspace --locked; \
		ctest --test-dir build-gui --output-on-failure; \
	fi

# The daemon starts with the graphical session; dh_installsystemduser installs and
# enables the user unit. The package installation cannot start a user session.
override_dh_installsystemduser:
	dh_installsystemduser --name=orbiscreen
