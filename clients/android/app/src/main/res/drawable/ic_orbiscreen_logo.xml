<?xml version="1.0" encoding="utf-8"?>
<!-- ─────────────────────────────────────────────
     Orbiscreen - Android In-App Logo
     https://github.com/shadow-x78/orbiscreen

     The project mark on the 512 grid, identical to data/orbiscreen.svg and to the launcher
     foreground: ring r 181 stroke 58, dot r 66 at (384,384). It is drawn 1:1 (no group scale),
     so whatever viewport hosts it decides the rendered size.
     ───────────────────────────────────────────── -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="512dp"
    android:height="512dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <path
        android:fillColor="@android:color/transparent"
        android:strokeColor="#89B4FA"
        android:strokeWidth="58"
        android:pathData="M256,256 m-181,0 a181,181 0 1 1 362,0 a181,181 0 1 1 -362,0" />
    <path
        android:fillColor="#89B4FA"
        android:pathData="M384,384 m-66,0 a66,66 0 1 1 132,0 a66,66 0 1 1 -132,0" />
</vector>
