<?xml version="1.0" encoding="utf-8"?>
<!-- ─────────────────────────────────────────────
     Orbiscreen - Android Launcher Foreground Icon
     https://github.com/shadow-x78/orbiscreen

     The project mark on the same 512 grid as data/orbiscreen.svg: the O of Orbiscreen as a
     display ring (r 181, stroke 58) with the device screen - a solid dot (r 66 at 384,384) -
     riding its path. The group scales that grid to 0.66 of the 108dp adaptive canvas.

     Safe-area math: the dot reaches 247 units from the centre, i.e. 247/512 * 108 * 0.66 =
     34.4dp. That is inside the 36dp visible circle (72dp diameter) with >1dp to spare, so no
     launcher mask clips it, while the ring (210 units -> 29.2dp) fills the tile instead of
     floating small inside it.
     ───────────────────────────────────────────── -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">
    <group
        android:scaleX="0.66"
        android:scaleY="0.66"
        android:pivotX="256"
        android:pivotY="256">
        <path
            android:fillColor="@android:color/transparent"
            android:strokeColor="#89B4FA"
            android:strokeWidth="58"
            android:pathData="M256,256 m-181,0 a181,181 0 1 1 362,0 a181,181 0 1 1 -362,0" />
        <path
            android:fillColor="#89B4FA"
            android:pathData="M384,384 m-66,0 a66,66 0 1 1 132,0 a66,66 0 1 1 -132,0" />
    </group>
</vector>
