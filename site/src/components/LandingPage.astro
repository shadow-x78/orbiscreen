---
// ─────────────────────────────────────────────
// Orbiscreen · Landing page
// ─────────────────────────────────────────────

import Icon from './Icon.astro';
import InstallTabs from './InstallTabs.astro';
import DownloadButtons from './DownloadButtons.astro';
import RelatedDocs from './RelatedDocs.astro';
import { landing } from '../data/landing';
import { installMethods, downloads } from '../data/install';
import { GITHUB_URL, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const d = landing[lang];
const methods = installMethods[lang];
const dl = downloads[lang];

const trustChips = [
  { label: lang === 'ar' ? 'Wayland وX11' : 'Wayland & X11', dot: 'dot--interactive', mono: false },
  { label: 'NVENC · VA-API · x264', dot: 'dot--success', mono: true },
  { label: lang === 'ar' ? 'Android والويب' : 'Android + Web', dot: 'dot--warning', mono: false },
  { label: 'GPL-3.0', dot: 'dot--brand', mono: false },
  { label: 'Rust 1.92+', dot: 'dot--danger', mono: true },
];

const arrowName = lang === 'ar' ? 'arrow-left' : 'arrow-right';
const trailingArrow = lang === 'ar' ? 'arrow-cta-left' : 'arrow-cta';
const githubStore = dl.host[0];
const playStore = dl.clients.find((button) => button.icon === 'play')!;
const installHref = lang === 'ar' ? '/ar/install' : '/install';
const contributingHref = `${GITHUB_URL}/blob/main/CONTRIBUTING.md`;
---


<section class="hero">
  <div class="container hero__inner">
    <div class="hero__text">
      <div class="hero__eyebrow hero-enter hero-enter--0">
        <span class="pill pill--brand pill--mono">
          <span class="pill__dot dot--brand"></span>{d.hero.pills[0]}
        </span>
        <span class="pill pill--surface">
          <span class="pill__dot dot--success"></span>{d.hero.pills[1]}
        </span>
        <span class="pill pill--surface pill--mono">
          <span class="pill__dot dot--warning"></span>{d.hero.pills[2]}
        </span>
      </div>

      <h1 class="hero__title hero-enter hero-enter--1">{d.hero.title}</h1>
      <p class="hero__sub hero-enter hero-enter--2">{d.hero.sub}</p>

      <div class="hero__cta hero-enter hero-enter--3">
        <a class="btn btn--primary btn--lg" href={installHref}>
          {d.hero.primary}
          <Icon name={trailingArrow} size={16} class="btn__arrow" />
        </a>
        <a class="btn btn--secondary btn--lg" href={GITHUB_URL} rel="noopener">{d.hero.secondary}</a>
      </div>

      <div class="hero__store hero-enter hero-enter--4">
        <a class="dl-btn" href={playStore.href} rel="noopener" data-loading>
          <span class="dl-btn__icon"><Icon name="play" size={20} /></span>
          <span class="dl-btn__stack">
            <span class="dl-btn__micro">{playStore.micro}</span>
            <span class="dl-btn__main">{playStore.main}</span>
          </span>
        </a>
        <a class="dl-btn" href={githubStore.href} rel="noopener" data-loading>
          <span class="dl-btn__icon"><Icon name="github" size={20} /></span>
          <span class="dl-btn__stack">
            <span class="dl-btn__micro">{lang === 'ar' ? 'كل الحزم' : 'All packages'}</span>
            <span class="dl-btn__main">GitHub Releases</span>
          </span>
        </a>
      </div>

      <p class="hero__trust hero-enter hero-enter--5">{d.hero.trust}</p>
    </div>

    <div class="hero__visual hero-enter hero-enter--4" aria-hidden="true">
      <div class="mockup">
        <div class="mockup__monitor">
          <div class="mockup__windowbar">
            <span class="mockup__dot dot--danger"></span>
            <span class="mockup__dot dot--warning"></span>
            <span class="mockup__dot dot--success"></span>
            <span class="mockup__title">orbiscreen · display 2</span>
            <span class="mockup__res"><span class="mockup__res-full">1920x1080 · 60Hz</span><span class="mockup__res-short">1080p · 60Hz</span></span>
          </div>
          <div class="mockup__desktop">
            <div class="mockup__pane">
              <span class="mockup__bar"></span>
              <span class="mockup__bar"></span>
              <span class="mockup__bar"></span>
              <span class="mockup__pane-foot"><span class="mockup__codec">H.264 NVENC</span></span>
            </div>
            <div class="mockup__pane mockup__pane--extended">
              <span class="mockup__bar mockup__bar--accent"></span>
              <span class="mockup__bar"></span>
              <span class="mockup__bar"></span>
              <span class="mockup__pane-foot">
                <span class="mockup__badge">Extended</span>
              </span>
            </div>
          </div>
        </div>

        <span class="mockup__stand"></span>
        <span class="mockup__base"></span>

        <div class="mockup__tablet">
          <div class="mockup__screen">
            <span></span>
            <span></span>
            <span></span>
            <span></span>
          </div>
        </div>

        <span class="mockup__link"></span>

        <span class="mockup__chip" dir={lang === 'ar' ? 'rtl' : 'ltr'}>
          <span class="mockup__chip-dot"></span>
          {lang === 'ar' ? '2-4 ms · النقل' : '2-4 ms transport'}
        </span>
      </div>
    </div>
  </div>
</section>

<section class="trust" aria-label={lang === 'ar' ? 'المنصات المدعومة' : 'Supported platforms'}>
  <div class="container">
    <div class="trust__row" data-reveal>
      {trustChips.map((chip) => (
        <span class:list={['chip', chip.mono && 'chip--mono']}>
          <span class:list={['chip__dot', chip.dot]}></span>
          {chip.label}
        </span>
      ))}
    </div>
  </div>
</section>

<section class="caps">
  <div class="container">
    <div class="caps__head">
      <p class="eyebrow">{d.capabilities.eyebrow}</p>
      <h2 class="caps__title">{d.capabilities.title}</h2>
    </div>
    <div class="bento">
      {d.capabilities.tiles.map((tile, index) => (
        <article class:list={['tile', index === 0 && 'tile--feature']} data-reveal data-sheen>
          <span class="tile__icon"><Icon name={tile.icon} size={index === 0 ? 22 : 20} /></span>
          <h3 class="tile__title">{tile.title}</h3>
          <p class="tile__body">{tile.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="hiw">
  <div class="container">
    <div class="hiw__head">
      <p class="eyebrow">{d.howItWorks.eyebrow}</p>
      <h2 class="hiw__title">{d.howItWorks.title}</h2>
    </div>
    <div class="steps">
      {d.howItWorks.steps.map((step) => (
        <article class="step" data-reveal>
          <span class="step__num">{step.num}</span>
          <h3 class="step__title">{step.title}</h3>
          <p class="step__body">{step.body}</p>
          <p class="step__mono" dir="ltr">{step.mono}</p>
        </article>
      ))}
    </div>
    <p class="hiw__footnote">{d.howItWorks.footnote}</p>
  </div>
</section>

<section class="demo-band" aria-labelledby="demo-title">
  <div class="container demo-band__grid">
    <div class="demo-band__copy">
      <p class="eyebrow">{lang === 'ar' ? 'عرض' : 'Demo'}</p>
      <h2 class="demo-band__title" id="demo-title">{lang === 'ar' ? 'شاهده أثناء العمل.' : 'See it in action.'}</h2>
      <p class="demo-band__body">
        {lang === 'ar'
          ? 'اسحب نافذة إلى الجهاز اللوحي، وبث H.264 عبر الشبكة أو USB، وأعد اللمس والقلم إلى Linux.'
          : 'Drag a window to the tablet, stream H.264 over LAN or USB, and send touch and pen back to Linux.'}
      </p>
      <p class="demo-band__meta mono">
        {lang === 'ar' ? '32 ثانية · بلا صوت' : '32s loop · silent'}
      </p>
      <a class="btn btn--secondary" href="/assets/demo/orbiscreen-demo.mp4">
        {lang === 'ar' ? 'شاهد الفيديو الكامل' : 'Watch the full video'}
      </a>
    </div>
    <div class="demo-band__media">
      <video
        autoplay
        muted
        loop
        playsinline
        preload="metadata"
        poster="/assets/demo/orbiscreen-demo-poster.png"
        aria-label={lang === 'ar' ? 'عرض Orbiscreen: جهاز لوحي يصبح شاشة ثانية' : 'Orbiscreen demo: a tablet becomes a second display'}
      >
        <source src="/assets/demo/orbiscreen-demo-480.mp4" type="video/mp4" />
      </video>
    </div>
  </div>
</section>

<section class="platform">
  <div class="container platform__grid">
    <div class="platform__intro">
      <p class="eyebrow">{d.platform.eyebrow}</p>
      <h2 class="platform__title">{d.platform.title}</h2>
      <p class="platform__sub">{d.platform.sub}</p>
    </div>

    <div class="matrix" role="table" aria-label={lang === 'ar' ? 'دعم بيئات سطح المكتب' : 'Desktop support'}>
      {d.platform.rows.map((row) => (
        <div class="matrix__row" role="row" data-reveal>
          <span class="matrix__name" role="cell" dir="ltr">{row.name}</span>
          <span class="matrix__status" role="cell">
            <span
              class:list={[
                'matrix__dot',
                row.status.includes('EVDI')
                  ? 'dot--warning'
                  : row.status.includes('Portal')
                    ? 'dot--interactive'
                    : 'dot--success',
              ]}
            ></span>
            {row.status}
          </span>
        </div>
      ))}
    </div>

    <div class="doctor">
      <span class="doctor__label">{d.platform.doctorLabel}</span>
      <span class="doctor__cmd">{d.platform.doctorCmd}</span>
      <span class="doctor__out">{d.platform.doctorOut}</span>
    </div>
  </div>
</section>

<section class="perf">
  <div class="container">
    <div class="perf__head">
      <p class="eyebrow">{d.performance.eyebrow}</p>
      <h2 class="perf__title">{d.performance.title}</h2>
    </div>
    <div class="stats">
      {d.performance.stats.map((stat) => (
        <div class="stat" data-reveal>
          <span class="stat__value" dir="ltr">{stat.value}</span>
          <span class="stat__label">{stat.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="install-landing" id="install">
  <div class="container install-landing__inner">
    <div class="install-landing__head">
      <p class="eyebrow">{d.install.eyebrow}</p>
      <h2 class="install-landing__title">{d.install.title}</h2>
    </div>

    <InstallTabs lang={lang} methods={methods} compact />

    <DownloadButtons label={d.install.hostLabel} items={dl.host} compact />
    <DownloadButtons label={d.install.clientsLabel} items={dl.clients} compact />
  </div>
</section>

<section class="oss">
  <div class="container">
    <div class="oss__card" data-reveal>
      <div class="oss__text">
        <h2 class="oss__title">{d.oss.title}</h2>
        <p class="oss__body">{d.oss.body}</p>
        <div class="oss__actions">
          <a class="btn btn--primary" href={GITHUB_URL} rel="noopener">
            <Icon name="github" size={18} />
            {d.oss.primary}
          </a>
          <a class="btn btn--ghost" href={contributingHref} rel="noopener">
            {d.oss.secondary}
            <Icon name={arrowName} size={14} class="btn__arrow" />
          </a>
        </div>
      </div>
      <div class="oss__stats">
        {d.oss.stats.map((stat) => (
          <div class="oss__stat">
            <span class="oss__stat-key">{stat.key}</span>
            <span class="oss__stat-val">{stat.value}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<RelatedDocs lang={lang} page="home" />
