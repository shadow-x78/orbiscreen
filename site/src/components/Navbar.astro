---
// ─────────────────────────────────────────────
// Orbiscreen · Navbar and mobile drawer
// ─────────────────────────────────────────────

import Icon from './Icon.astro';
import { ui } from '../data/i18n';
import { GITHUB_URL, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
  path: string;
  arPath: string;
}

const { lang, path, arPath } = Astro.props;
const t = ui[lang];
const prefix = lang === 'ar' ? '/ar' : '';
const current = lang === 'ar' ? arPath : path;

const localise = (href: string) => (href === '/' ? prefix || '/' : `${prefix}${href}`);

const links = [
  { label: t.nav.features, href: localise('/features'), match: '/features' },
  { label: t.nav.install, href: localise('/install'), match: '/install' },
  { label: t.nav.docs, href: localise('/docs'), match: '/docs' },
  { label: t.nav.compare, href: localise('/compare'), match: '/compare' },
];

const drawerLinks = [
  ...links,
  { label: t.nav.faq, href: localise('/faq'), match: '/faq' },
  { label: t.nav.changelog, href: localise('/changelog'), match: '/changelog' },
];

function isActive(match: string): boolean {
  const target = lang === 'ar' ? `/ar${match}` : match;
  return current === target || current.startsWith(`${target}/`);
}
---

<header class="nav site-nav" data-nav>
  <div class="container nav__inner">
    <a class="brand" href={prefix || '/'} aria-label="Orbiscreen">
      <svg class="brand__mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <circle cx="12" cy="12" r="8.625" fill="none" stroke="var(--accent-brand)" stroke-width="2.953" />
        <circle cx="18.0935" cy="18.0935" r="3.1875" fill="var(--accent-brand)" />
      </svg>
      <span class="brand__word">Orbiscreen</span>
    </a>

    <nav class="nav__links" aria-label={t.nav.primary}>
      {links.map((link) => (
        <a class="nav__link" href={link.href} aria-current={isActive(link.match) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
      <a class="nav__link" href={GITHUB_URL} rel="noopener">{t.nav.github}</a>
    </nav>

    <div class="nav__actions">
      <div class="lang" dir="ltr" role="group" aria-label={t.nav.language}>
        <a
          class="lang__opt"
          href={path}
          hreflang="en"
          lang="en"
          aria-current={lang === 'en' ? 'true' : undefined}
        >EN</a>
        <a
          class="lang__opt"
          href={arPath}
          hreflang="ar"
          lang="ar"
          aria-current={lang === 'ar' ? 'true' : undefined}
        >عربي</a>
      </div>
      <a class="btn btn--primary btn--sm" href={localise('/install')}>{t.nav.cta}</a>
      <button
        class="nav__menu"
        type="button"
        data-drawer-open
        aria-label={t.nav.menu}
        aria-controls="site-drawer"
        aria-expanded="false"
      >
        <span></span>
      </button>
    </div>
  </div>
</header>

<div class="drawer" id="site-drawer" data-drawer hidden>
  <div class="drawer__backdrop" data-drawer-close></div>
  <aside
    class="drawer__panel"
    role="dialog"
    aria-modal="true"
    aria-label={t.nav.dialog}
    tabindex="-1"
    data-drawer-panel
  >
    <div class="drawer__head">
      <a class="brand" href={prefix || '/'} aria-label="Orbiscreen">
        <svg class="brand__mark" viewBox="0 0 22 22" aria-hidden="true" focusable="false">
          <circle cx="10.906" cy="10.906" r="7.906" fill="none" stroke="var(--accent-brand)" stroke-width="2.707" />
          <circle cx="16.906" cy="16.906" r="2.922" fill="var(--accent-brand)" />
        </svg>
        <span class="brand__word">Orbiscreen</span>
      </a>
      <button class="drawer__close" type="button" data-drawer-close aria-label={t.nav.close}>
        <Icon name="close" size={16} />
      </button>
    </div>

    <nav class="drawer__nav" aria-label={t.nav.primary}>
      {drawerLinks.map((link) => (
        <a class="drawer__link" href={link.href} aria-current={isActive(link.match) ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
      <a class="drawer__link" href={GITHUB_URL} rel="noopener">{t.nav.github}</a>
    </nav>

    <div class="lang drawer__lang" dir="ltr" role="group" aria-label={t.nav.language}>
      <a
        class="lang__opt"
        href={path}
        hreflang="en"
        lang="en"
        aria-current={lang === 'en' ? 'true' : undefined}
      >EN</a>
      <a
        class="lang__opt"
        href={arPath}
        hreflang="ar"
        lang="ar"
        aria-current={lang === 'ar' ? 'true' : undefined}
      >عربي</a>
    </div>

    <div class="drawer__bottom">
      <a class="btn btn--primary drawer__cta" href={localise('/install')}>{t.nav.cta}</a>
      <a class="drawer__github" href={GITHUB_URL} rel="noopener">
        <Icon name="github" size={18} />
        GitHub
      </a>
    </div>
  </aside>
</div>
