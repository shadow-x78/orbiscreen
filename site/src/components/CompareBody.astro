---
// ─────────────────────────────────────────────
// Orbiscreen - Comparison page body
// https://github.com/shadow-x78/orbiscreen
// ─────────────────────────────────────────────

import '../styles/docs.css';
import PageHead from './PageHead.astro';
import Icon from './Icon.astro';
import CompareTable from './CompareTable.astro';
import { pages } from '../data/pages';
import { comparison } from '../data/compare';
import { ui } from '../data/i18n';
import type { Lang } from '../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const page = pages.compare[lang];
const t = ui[lang];
const installHref = lang === 'ar' ? '/ar/install' : '/install';
const architectureHref = lang === 'ar' ? '/ar/docs/architecture' : '/docs/architecture';
---

<PageHead
  lang={lang}
  eyebrow={page.eyebrow}
  title={page.title}
  lede={page.lede}
  breadcrumbs={[
    { label: t.labels.breadcrumbHome },
    { label: t.nav.compare },
  ]}
/>

<section class="section">
  <div class="container">
    <CompareTable
      rows={comparison[lang]}
      lang={lang}
      caption={lang === 'ar' ? 'مقارنة أدوات الشاشة الثانية' : 'Second-screen tool comparison'}
    />

    <div class="grid-2" style="margin-block-start:40px">
      {page.differences.map((item) => (
        <article class="card">
          <h2 class="h3" style="font-size:18px;margin-block-end:8px">{item.title}</h2>
          <p class="muted" style="font-size:14.5px;line-height:1.7">{item.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="section section--subtle">
  <div class="container">
    <div class="section__head">
      <h2 class="h2">{page.methodology.title}</h2>
    </div>
    <div class="feature-row__body" style="max-width:74ch">
      {page.methodology.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    <div class="cta-card" style="margin-block-start:40px">
      <div class="cta-card__text">
        <h2 class="h3">{page.cta.title}</h2>
        <p>{page.cta.body}</p>
      </div>
      <div class="cta-card__actions">
        <a class="btn btn--primary" href={installHref}>
          {page.cta.primary}
          <Icon name="arrow-right" size={18} />
        </a>
        <a class="btn btn--secondary" href={architectureHref}>{page.cta.secondary}</a>
      </div>
    </div>
  </div>
</section>