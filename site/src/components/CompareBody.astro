---
// ─────────────────────────────────────────────
// Orbiscreen · Compare page body
// ─────────────────────────────────────────────

import '../styles/docs.css';
import PageHead from './PageHead.astro';
import Icon from './Icon.astro';
import CompareTable from './CompareTable.astro';
import { pages } from '../data/pages';
import { comparison } from '../data/compare';
import { ui } from '../data/i18n';
import type { Lang } from '../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const page = pages.compare[lang];
const t = ui[lang];
const prefix = lang === 'ar' ? '/ar' : '';
const installHref = `${prefix}/install`;
const architectureHref = `${prefix}/docs/architecture`;
const trailingArrow = lang === 'ar' ? 'arrow-cta-left' : 'arrow-cta';
---

<PageHead
  lang={lang}
  eyebrow={page.eyebrow}
  title={page.title}
  lede={page.lede}
  breadcrumbs={[
    { label: t.labels.breadcrumbHome },
    { label: t.nav.compare },
  ]}
/>

<section class="compare-sec">
  <div class="container">
    <div class="compare-intro">
      <p class="eyebrow">{lang === 'ar' ? 'المصفوفة' : 'Matrix'}</p>
      <h2 class="compare-intro__title">{lang === 'ar' ? 'قدرة بقدرة.' : 'Capability by capability.'}</h2>
    </div>

    <CompareTable
      rows={comparison[lang]}
      lang={lang}
      caption={lang === 'ar' ? 'مقارنة أدوات الشاشة الثانية' : 'Second-screen tool comparison'}
    />
  </div>
</section>

<section class="compare-method">
  <div class="container">
    <h2 class="compare-method__title">{page.methodology.title}</h2>
    <div class="compare-method__body">
      {page.methodology.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>
  </div>
</section>

<section class="differences">
  <div class="container">
    <div class="differences__head">
      <p class="eyebrow">{lang === 'ar' ? 'الفروق' : 'Differences'}</p>
      <h2 class="differences__title">{lang === 'ar' ? 'ما يتغير عمليا.' : 'What changes in practice.'}</h2>
    </div>
    <div class="diff-grid">
      {page.differences.map((item) => (
        <article class="diff-card" data-reveal>
          <h3 class="diff-card__title">{item.title}</h3>
          <p class="diff-card__body">{item.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="cta-section">
  <div class="container">
    <div class="cta-card" data-reveal>
      <h2 class="cta-card__title">{page.cta.title}</h2>
      <p class="cta-card__body">{page.cta.body}</p>
      <div class="cta-card__actions">
        <a class="btn btn--primary" href={installHref}>
          {page.cta.primary}
          <Icon name={trailingArrow} size={16} class="btn__arrow" />
        </a>
        <a class="btn btn--secondary" href={architectureHref}>{page.cta.secondary}</a>
      </div>
    </div>
  </div>
</section>
