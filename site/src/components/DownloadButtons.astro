---
// ─────────────────────────────────────────────
// Orbiscreen · Download button grid
// ─────────────────────────────────────────────

import Icon from './Icon.astro';
import type { DownloadButton } from '../data/install';

interface Props {
  label: string;
  items: DownloadButton[];
  compact?: boolean;
}

const { label, items, compact = false } = Astro.props;
---

<div class:list={['downloads', compact ? 'downloads--compact' : 'downloads--full']}>
  <p class="downloads__label">{label}</p>
  <div class="downloads__grid">
    {items.map((item) => (
      <a
        class="dl-btn"
        href={item.href}
        rel={item.external ? 'noopener' : undefined}
        data-loading
      >
        <span class="dl-btn__icon"><Icon name={item.icon} size={24} /></span>
        <span class="dl-btn__stack">
          <span class="dl-btn__micro">{item.micro}</span>
          <span class="dl-btn__main">{item.main}</span>
        </span>
      </a>
    ))}
  </div>
</div>
