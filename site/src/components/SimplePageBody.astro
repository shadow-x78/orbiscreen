---
// ─────────────────────────────────────────────
// Orbiscreen · Simple content page body
// ─────────────────────────────────────────────

import '../styles/docs.css';
import PageHead from './PageHead.astro';
import type { SimplePage } from '../data/legal';
import { ui } from '../data/i18n';
import type { Lang } from '../lib/site';

interface Props {
  lang: Lang;
  page: SimplePage;
  crumb: string;
}

const { lang, page, crumb } = Astro.props;
const t = ui[lang];
const isLicense = page.title.startsWith('GPL-3.0-or-later');

const facts = [
  { key: lang === 'ar' ? 'الرخصة' : 'License', value: 'GPL-3.0-or-later' },
  { key: lang === 'ar' ? 'مضمن' : 'Bundled', value: 'MIT (qrcode.js)' },
  { key: lang === 'ar' ? 'الضمان' : 'Warranty', value: lang === 'ar' ? 'لا يوجد' : 'None' },
];
---

<PageHead
  lang={lang}
  eyebrow={page.eyebrow}
  title={page.title}
  lede={page.lede}
  breadcrumbs={[
    { label: t.labels.breadcrumbHome },
    { label: crumb },
  ]}
/>

{isLicense && (
  <section class="legal-overview">
    <div class="container legal-overview__row">
      <p class="legal-overview__lede">{page.lede}</p>
      <div class="legal-facts">
        {facts.map((fact) => (
          <div class="legal-fact">
            <span class="legal-fact__key">{fact.key}</span>
            <span class="legal-fact__val">{fact.value}</span>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<section class="legal-prose">
  <div class="container">
    <div class="prose">
      {page.sections.map((section) => (
        <div class="prose-section">
          <h2>{section.title}</h2>
          {section.body.map((paragraph) => <p>{paragraph}</p>)}
          {section.list && (
            <ul>
              {section.list.map((item) => <li>{item}</li>)}
            </ul>
          )}
        </div>
      ))}
    </div>

    <div class="legal-links">
      <slot />
    </div>
  </div>
</section>
