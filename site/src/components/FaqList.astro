---
// ─────────────────────────────────────────────
// Orbiscreen · FAQ list
// ─────────────────────────────────────────────

import Icon from './Icon.astro';
import type { FaqItem } from '../data/faq';

interface Props {
  items: FaqItem[];
  openFirst?: boolean;
}

const { items, openFirst = false } = Astro.props;
---

<div class="faq">
  {items.map((item, index) => (
    <details class="faq__item" id={item.id} open={openFirst && index === 0}>
      <summary>
        <span>{item.question}</span>
        <Icon name="chevron" size={16} class="faq__chevron" />
      </summary>
      <div class="faq__answer-wrap">
        <div class="faq__answer-inner">
          <div class="faq__answer">
            {item.answer.map((part) => <p set:html={part} />)}
          </div>
        </div>
      </div>
    </details>
  ))}
</div>
