---
// ─────────────────────────────────────────────
// Orbiscreen - Documentation index body
// https://github.com/shadow-x78/orbiscreen
// ─────────────────────────────────────────────

import { getCollection } from 'astro:content';
import '../styles/docs.css';
import PageHead from './PageHead.astro';
import Icon from './Icon.astro';
import docsMeta from '../data/docs-meta.json';
import { ui } from '../data/i18n';
import { GITHUB_URL, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
  eyebrow: string;
  title: string;
  lede: string;
}

const { lang, eyebrow, title, lede } = Astro.props;
const t = ui[lang];

const entries = await getCollection('docs', (entry) => entry.data.lang === lang);
const bySlug = new Map(entries.map((entry) => [entry.data.slug, entry]));

const groupLabels: Record<string, string> = {
  core: lang === 'ar' ? 'الأساس' : 'Core',
  guides: lang === 'ar' ? 'الأدلة' : 'Guides',
  reference: lang === 'ar' ? 'المراجع' : 'Reference',
};

const sections = Object.entries(groupLabels)
  .map(([group, label]) => ({
    label,
    cards: docsMeta.docs
      .filter((doc) => doc.group === group)
      .map((doc) => {
        const entry = bySlug.get(doc.slug);
        return {
          href: `${lang === 'ar' ? '/ar' : ''}/docs/${doc.slug}`,
          title: lang === 'ar' ? doc.titleAr : doc.title,
          description: lang === 'ar' ? doc.descriptionAr : doc.description,
          meta: entry ? `docs/${entry.data.source} · ${entry.data.updated}` : `docs/${doc.slug}`,
        };
      }),
  }))
  .filter((section) => section.cards.length > 0);
---

<PageHead
  lang={lang}
  eyebrow={eyebrow}
  title={title}
  lede={lede}
  breadcrumbs={[
    { label: t.labels.breadcrumbHome },
    { label: t.labels.docs },
  ]}
/>

<section class="section">
  <div class="container">
    {sections.map((section) => (
      <div style="margin-block-end:44px">
        <h2 class="h3" style="margin-block-end:16px">{section.label}</h2>
        <div class="doc-cards">
          {section.cards.map((card) => (
            <a class="doc-card" href={card.href}>
              <span class="doc-card__title">{card.title}</span>
              <span class="doc-card__desc">{card.description}</span>
              <span class="doc-card__meta">{card.meta}</span>
            </a>
          ))}
        </div>
      </div>
    ))}

    <div class="cta-card">
      <div class="cta-card__text">
        <h2 class="h3">{lang === 'ar' ? 'التوثيق الكامل على GitHub' : 'The full source is on GitHub'}</h2>
        <p>
          {lang === 'ar'
            ? 'كل مستند يعيش بجانب الشيفرة التي يصفها، ويمكنك قراءته أو تعديله هناك.'
            : 'Every document lives next to the code it describes, so you can read or amend it in place.'}
        </p>
      </div>
      <div class="cta-card__actions">
        <a class="btn btn--secondary" href={`${GITHUB_URL}/tree/main/docs`} rel="noopener">
          <Icon name="github" size={18} />
          {lang === 'ar' ? 'افتح docs/' : 'Open docs/'}
        </a>
      </div>
    </div>
  </div>
</section>