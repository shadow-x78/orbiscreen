---
// ─────────────────────────────────────────────
// Orbiscreen · Documentation index body
// ─────────────────────────────────────────────

import { getCollection } from 'astro:content';
import '../styles/docs.css';
import PageHead from './PageHead.astro';
import Icon from './Icon.astro';
import docsMeta from '../data/docs-meta.json';
import { ui } from '../data/i18n';
import { GITHUB_URL, ISSUES_URL, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
  eyebrow: string;
  title: string;
  lede: string;
}

const { lang, eyebrow, title, lede } = Astro.props;
const t = ui[lang];
const prefix = lang === 'ar' ? '/ar' : '';

const entries = await getCollection('docs', (entry) => entry.data.lang === lang);
const bySlug = new Map(entries.map((entry) => [entry.data.slug, entry]));

const groupLabels: Record<string, string> = {
  core: lang === 'ar' ? 'الأساس' : 'Core',
  guides: lang === 'ar' ? 'الأدلة' : 'Guides',
  reference: lang === 'ar' ? 'المراجع' : 'Reference',
};

const start = lang === 'ar'
  ? {
      eyebrow: 'ابدأ هنا',
      title: 'اختر مسارك.',
      items: [
        {
          title: 'جديد على Orbiscreen',
          body: 'افهم الأجزاء قبل التثبيت: خادم المضيف، والشاشة الافتراضية، والنقل، والعميل.',
          links: [
            { label: 'المعمارية', href: `${prefix}/docs/architecture` },
            { label: 'دعم بيئات سطح المكتب', href: `${prefix}/docs/de-support` },
          ],
        },
        {
          title: 'ثبّت واقرن عميلا',
          body: 'اختر حزمة توزيعتك، ثم اتصل بتطبيق Android أو المتصفح.',
          links: [
            { label: 'التثبيت', href: `${prefix}/install` },
            { label: 'حل الأعطال', href: `${prefix}/docs/troubleshooting` },
          ],
        },
        {
          title: 'دبّج البث',
          body: 'تتبع إطارا من الالتقاط إلى فك الترميز، وافحص مسار الحزم عند ظهور زمن استجابة أو فقد.',
          links: [
            { label: 'نقل UDP', href: `${prefix}/docs/udp-transport` },
            { label: 'نقل الإطارات', href: `${prefix}/docs/frame-transport` },
          ],
        },
      ],
      conventionsTitle: 'كيف كتبت هذه المستندات',
      conventions:
        'كل صفحة تذكر ما تفترضه، وتسمي الملفات والأوامر التي تصفها بدقة، وتنتهي بالفحوص التي تؤكد السلوك. وتذكر الملاحظات الخاصة بالإصدار رقمه، فتبقى الصفحة القديمة مطابقة للبناء الذي تشغله.',
      helpTitle: 'حين لا تجيب المستندات',
      help:
        'ابحث في صفحة حل الأعطال أولا؛ فهي تربط الأعراض بالأوامر. وإن غاب الجواب فافتح بلاغا مع مخرجات orbiscreen doctor والإصدار الذي تشغله.',
      helpLinks: [
        { label: 'حل الأعطال', href: `${prefix}/docs/troubleshooting` },
        { label: 'افتح بلاغا', href: ISSUES_URL },
      ],
    }
  : {
      eyebrow: 'Start here',
      title: 'Choose a path.',
      items: [
        {
          title: 'New to Orbiscreen',
          body: 'Learn the moving parts before you install: the host daemon, the virtual display, the transport, and the client.',
          links: [
            { label: 'Architecture', href: `${prefix}/docs/architecture` },
            { label: 'Desktop support', href: `${prefix}/docs/de-support` },
          ],
        },
        {
          title: 'Install and pair a client',
          body: 'Pick the package for your distribution, then connect the Android app or a browser.',
          links: [
            { label: 'Installation', href: `${prefix}/install` },
            { label: 'Troubleshooting', href: `${prefix}/docs/troubleshooting` },
          ],
        },
        {
          title: 'Debug a stream',
          body: 'Follow a frame from capture to decode, and check the packet path when latency or packet loss appears.',
          links: [
            { label: 'UDP transport', href: `${prefix}/docs/udp-transport` },
            { label: 'Frame transport', href: `${prefix}/docs/frame-transport` },
          ],
        },
      ],
      conventionsTitle: 'How these documents are written',
      conventions:
        'Each page states what it assumes, names the exact files and commands it describes, and ends with the checks that confirm the behaviour. Version-specific notes name the release, so an older page still matches the build you run.',
      helpTitle: 'When the docs do not answer it',
      help:
        'Search the troubleshooting page first; it maps symptoms to commands. If the answer is missing, open an issue with the output of orbiscreen doctor and the release you run.',
      helpLinks: [
        { label: 'Troubleshooting', href: `${prefix}/docs/troubleshooting` },
        { label: 'Open an issue', href: ISSUES_URL },
      ],
    };

function chunk<T>(items: T[], size: number): T[][] {
  const out: T[][] = [];
  for (let i = 0; i < items.length; i += size) out.push(items.slice(i, i + size));
  return out;
}

const sections = Object.entries(groupLabels)
  .map(([group, label]) => ({
    label,
    rows: chunk(
      docsMeta.docs
        .filter((doc) => doc.group === group)
        .map((doc) => {
          const entry = bySlug.get(doc.slug);
          return {
            href: `${prefix}/docs/${doc.slug}`,
            title: lang === 'ar' ? doc.titleAr : doc.title,
            description: lang === 'ar' ? doc.descriptionAr : doc.description,
            meta: entry ? `docs/${doc.source}.md · ${entry.data.updated}` : `docs/${doc.slug}`,
          };
        }),
      2,
    ),
  }))
  .filter((section) => section.rows.length > 0);
---

<PageHead
  lang={lang}
  eyebrow={eyebrow}
  title={title}
  lede={lede}
  breadcrumbs={[
    { label: t.labels.breadcrumbHome },
    { label: t.labels.docs },
  ]}
/>

<section class="docs-index">
  <div class="container">
    {sections.map((section) => (
      <div class="docs-group">
        <h2 class="docs-group__title">{section.label}</h2>
        {section.rows.map((row) => (
          <div class="docs-row">
            {row.map((card) => (
              <a class="doc-card" href={card.href} data-reveal data-sheen>
                <span class="doc-card__title">{card.title}</span>
                <span class="doc-card__desc">{card.description}</span>
                <span class="doc-card__meta">{card.meta}</span>
              </a>
            ))}
          </div>
        ))}
      </div>
    ))}

    <div class="docs-group">
      <p class="eyebrow">{start.eyebrow}</p>
      <h2 class="docs-group__title">{start.title}</h2>
      <div class="docs-row">
        {start.items.map((item) => (
          <div class="doc-card">
            <span class="doc-card__title">{item.title}</span>
            <span class="doc-card__desc">{item.body}</span>
            <p class="docs-start__links">
              {item.links.map((link, index) => (
                <>
                  {index > 0 && <span aria-hidden="true"> · </span>}
                  <a class="docs-start__link" href={link.href}>{link.label}</a>
                </>
              ))}
            </p>
          </div>
        ))}
      </div>
    </div>

    <div class="docs-group">
      <h2 class="docs-group__title">{start.conventionsTitle}</h2>
      <p class="docs-start__body">{start.conventions}</p>
    </div>

    <div class="docs-group">
      <h2 class="docs-group__title">{start.helpTitle}</h2>
      <p class="docs-start__body">{start.help}</p>
      <p class="docs-start__links">
        {start.helpLinks.map((link, index) => (
          <>
            {index > 0 && <span aria-hidden="true"> · </span>}
            <a
              class="docs-start__link"
              href={link.href}
              rel={link.href.startsWith('http') ? 'noopener' : undefined}
            >{link.label}</a>
          </>
        ))}
      </p>
    </div>

    <div class="docs-cta" data-reveal>
      <div>
        <h2 class="docs-cta__title">{lang === 'ar' ? 'المصدر الكامل على GitHub' : 'The full source is on GitHub'}</h2>
        <p class="docs-cta__body">
          {lang === 'ar'
            ? 'كل مستند يعيش بجانب الشيفرة التي يصفها، ويمكنك قراءته أو تعديله هناك.'
            : 'Every document lives next to the code it describes, so you can read or amend it in place.'}
        </p>
      </div>
      <a class="btn btn--secondary" href={`${GITHUB_URL}/tree/main/docs`} rel="noopener">
        <Icon name="github" size={18} />
        {lang === 'ar' ? 'افتح docs/' : 'Open docs/'}
      </a>
    </div>
  </div>
</section>
