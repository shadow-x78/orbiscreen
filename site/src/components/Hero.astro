---
// ─────────────────────────────────────────────
// Orbiscreen - Hero section
// https://github.com/shadow-x78/orbiscreen
// ─────────────────────────────────────────────

import HeroVisual from './HeroVisual.astro';
import Icon from './Icon.astro';
import { GITHUB_URL, type Lang } from '../lib/site';
import { CHANGELOG_ANCHOR } from '../lib/version';
import type { Landing } from '../data/landing';

interface Props {
  lang: Lang;
  hero: Landing['hero'];
}

const { lang, hero } = Astro.props;
const installHref = lang === 'ar' ? '/ar/install' : '/install';
const changelogHref = `${lang === 'ar' ? '/ar' : ''}/changelog#${CHANGELOG_ANCHOR}`;
---

<section class="hero">
  <div class="container hero__row">
    <div class="hero__col hero__col--copy">
      <p class="hero__meta">
        <a href={changelogHref} dir="ltr">{hero.pills.join(' · ')}</a>
      </p>

      <h1 class="h1">{hero.title}</h1>
      <p class="lede">{hero.sub}</p>

      <div class="hero__cta">
        <a class="btn btn--primary" href={installHref}>
          {hero.primary}
          <Icon name="arrow-right" size={18} />
        </a>
        <a class="btn btn--secondary" href={GITHUB_URL} rel="noopener">
          <Icon name="github" size={18} />
          {hero.secondary}
        </a>
      </div>

      <p class="hero__trust">{hero.trust}</p>
    </div>

    <div class="hero__col">
      <HeroVisual lang={lang} />
    </div>
  </div>
</section>
