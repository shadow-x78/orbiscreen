---
// ─────────────────────────────────────────────
// Orbiscreen · FAQ page body
// ─────────────────────────────────────────────

import '../styles/docs.css';
import PageHead from './PageHead.astro';
import Icon from './Icon.astro';
import FaqList from './FaqList.astro';
import { pages } from '../data/pages';
import { faq } from '../data/faq';
import { ui } from '../data/i18n';
import { ISSUES_URL, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const page = pages.faq[lang];
const t = ui[lang];
const prefix = lang === 'ar' ? '/ar' : '';
const troubleshootingHref = `${prefix}/docs/troubleshooting`;
const trailingArrow = lang === 'ar' ? 'arrow-left' : 'arrow-right-sm';

const groupDefs = lang === 'ar'
  ? [
      { title: 'العرض وسطح المكتب', ids: ['extended-or-mirror', 'wayland-without-root', 'desktops', 'black-screen'] },
      { title: 'الإدخال وزمن الاستجابة', ids: ['stylus', 'usb', 'latency'] },
      { title: 'الإعداد والترخيص', ids: ['clients', 'token', 'multiple-clients', 'price', 'privacy'] },
    ]
  : [
      { title: 'Display and desktops', ids: ['extended-or-mirror', 'wayland-without-root', 'desktops', 'black-screen'] },
      { title: 'Input and latency', ids: ['stylus', 'usb', 'latency'] },
      { title: 'Setup and licensing', ids: ['clients', 'token', 'multiple-clients', 'price', 'privacy'] },
    ];

const byId = new Map(faq[lang].map((item) => [item.id, item]));
const groups = groupDefs
  .map((group) => ({
    title: group.title,
    items: group.ids.map((id) => byId.get(id)).filter((item): item is NonNullable<typeof item> => Boolean(item)),
  }))
  .filter((group) => group.items.length > 0);
---

<PageHead
  lang={lang}
  eyebrow={page.eyebrow}
  title={page.title}
  lede={page.lede}
  breadcrumbs={[
    { label: t.labels.breadcrumbHome },
    { label: t.nav.faq },
  ]}
/>

<div class="faq-page">
  <div class="container">
    {groups.map((group, index) => (
      <section class="faq-group" aria-labelledby={`faq-group-${index}`}>
        <h2 class="faq-group__title" id={`faq-group-${index}`}>{group.title}</h2>
        <FaqList items={group.items} openFirst={index === 0} />
      </section>
    ))}

    <div class="cta-section">
      <div class="cta-card" data-reveal>
        <h2 class="cta-card__title">{page.cta.title}</h2>
        <p class="cta-card__body">{page.cta.body}</p>
        <div class="cta-card__actions">
          <a class="btn btn--primary" href={troubleshootingHref}>
            {page.cta.primary}
            <Icon name={trailingArrow} size={16} class="btn__arrow" />
          </a>
          <a class="btn btn--secondary" href={ISSUES_URL} rel="noopener">{page.cta.secondary}</a>
        </div>
      </div>
    </div>
  </div>
</div>
