---
// ─────────────────────────────────────────────
// Orbiscreen - FAQ page body
// https://github.com/shadow-x78/orbiscreen
// ─────────────────────────────────────────────

import '../styles/docs.css';
import PageHead from './PageHead.astro';
import Icon from './Icon.astro';
import FaqList from './FaqList.astro';
import { pages } from '../data/pages';
import { faq } from '../data/faq';
import { ui } from '../data/i18n';
import { ISSUES_URL, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const page = pages.faq[lang];
const t = ui[lang];
const troubleshootingHref = lang === 'ar' ? '/ar/docs/troubleshooting' : '/docs/troubleshooting';
---

<PageHead
  lang={lang}
  eyebrow={page.eyebrow}
  title={page.title}
  lede={page.lede}
  breadcrumbs={[
    { label: t.labels.breadcrumbHome },
    { label: t.nav.faq },
  ]}
/>

<section class="section">
  <div class="container">
    <FaqList items={faq[lang]} openFirst />

    <div class="cta-card" style="margin-block-start:40px">
      <div class="cta-card__text">
        <h2 class="h3">{page.cta.title}</h2>
        <p>{page.cta.body}</p>
      </div>
      <div class="cta-card__actions">
        <a class="btn btn--primary" href={troubleshootingHref}>
          {page.cta.primary}
          <Icon name="arrow-right" size={18} />
        </a>
        <a class="btn btn--secondary" href={ISSUES_URL} rel="noopener">{page.cta.secondary}</a>
      </div>
    </div>
  </div>
</section>