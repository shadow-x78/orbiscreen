---
// ─────────────────────────────────────────────
// Orbiscreen · Features page body
// ─────────────────────────────────────────────

import '../styles/docs.css';
import PageHead from './PageHead.astro';
import Icon from './Icon.astro';
import { pages } from '../data/pages';
import { ui } from '../data/i18n';
import type { Lang } from '../lib/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const page = pages.features[lang];
const t = ui[lang];
const prefix = lang === 'ar' ? '/ar' : '';
const installHref = `${prefix}/install`;
const docsHref = `${prefix}/docs`;
const trailingArrow = lang === 'ar' ? 'arrow-cta-left' : 'arrow-cta';

const iconFor: Record<string, string> = {
  'virtual-display': 'display',
  encoding: 'chip',
  input: 'pen',
  transport: 'usb',
  'web-client': 'globe',
  'android-client': 'monitor',
  control: 'terminal',
  security: 'shield',
};
---

<PageHead
  lang={lang}
  eyebrow={page.eyebrow}
  title={page.title}
  lede={page.lede}
  breadcrumbs={[
    { label: t.labels.breadcrumbHome },
    { label: t.nav.features },
  ]}
/>

<section class="feature-sections">
  <div class="container">
    {page.sections.map((section, index) => (
      <>
        {index > 0 && <hr class="feature-rule" />}
        <article class="feature-row" id={section.id}>
          <div class="feature-row__head" data-reveal>
            <span class="feature-row__icon"><Icon name={iconFor[section.id] || 'display'} size={22} /></span>
            <h2 class="feature-row__title">{section.title}</h2>
          </div>
          <div class="feature-row__body" data-reveal>
            {section.body.map((paragraph) => <p>{paragraph}</p>)}
            {section.points && (
              <ul class="points">
                {section.points.map((point) => <li class="point">{point}</li>)}
              </ul>
            )}
          </div>
        </article>
      </>
    ))}
  </div>
</section>

<section class="cta-section">
  <div class="container">
    <div class="cta-card" data-reveal>
      <h2 class="cta-card__title">{page.cta.title}</h2>
      <p class="cta-card__body">{page.cta.body}</p>
      <div class="cta-card__actions">
        <a class="btn btn--primary" href={installHref}>
          {page.cta.primary}
          <Icon name={trailingArrow} size={16} class="btn__arrow" />
        </a>
        <a class="btn btn--secondary" href={docsHref}>{page.cta.secondary}</a>
      </div>
    </div>
  </div>
</section>
