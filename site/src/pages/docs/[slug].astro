---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import DocLayout from '../../components/DocLayout.astro';
import { SITE_URL } from '../../lib/site';
import { breadcrumbSchema, techArticleSchema } from '../../lib/schema';
import docsMeta from '../../data/docs-meta.json';

export async function getStaticPaths() {
  const entries = await getCollection('docs', (entry) => entry.data.lang === 'en');
  return entries.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const slug = entry.data.slug;
const meta = docsMeta.docs.find((doc) => doc.slug === slug);
const seoTitle = meta?.seoTitle ?? entry.data.title;
const url = `${SITE_URL}/docs/${slug}`;
const words = (entry.body ?? '').split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.round(words / 200));

const schema = [
  techArticleSchema({
    headline: entry.data.title,
    description: entry.data.description,
    url,
    lang: 'en',
    dateModified: entry.data.updated,
  }),
  breadcrumbSchema([
    { name: 'Home', url: `${SITE_URL}/` },
    { name: 'Docs', url: `${SITE_URL}/docs` },
    { name: entry.data.title, url },
  ]),
];
---

<Base
  lang="en"
  title={seoTitle}
  description={entry.data.description}
  path={`/docs/${slug}`}
  arPath={`/ar/docs/${slug}`}
  type="article"
  schema={schema}
>
  <DocLayout
    lang="en"
    title={entry.data.title}
    description={entry.data.description}
    slug={slug}
    source={entry.data.source}
    updated={entry.data.updated}
    headings={headings}
    readingTime={readingTime}
  >
    <Content />
  </DocLayout>
</Base>