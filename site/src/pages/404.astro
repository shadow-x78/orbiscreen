---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';

const docsHref = '/docs';
---

<Base
  lang="en"
  title="Page not found"
  description="The requested page does not exist on orbiscreen.com. Browse the documentation index for architecture, transport and packaging guides, or return to the home page."
  path="/"
  arPath="/ar"
  noindex
>
  <section class="notfound">
    <div class="container">
      <div class="notfound__col">
        <p class="notfound__numeral">404 <span class="notfound__rule"></span></p>
        <p class="eyebrow">ERROR · NOT FOUND</p>
        <h1 class="notfound__title">That page does not exist.</h1>
        <p class="notfound__lede">
          The link may come from an older release, or the path may have changed. The documentation
          index and the home page are the fastest ways back.
        </p>
        <div class="notfound__actions">
          <a class="btn btn--primary" href="/">
            Back to the home page
            <Icon name="arrow-right-sm" size={16} class="btn__arrow" />
          </a>
          <a class="btn btn--secondary" href="/install">Install Orbiscreen</a>
          <a class="btn btn--ghost" href={docsHref}>Browse the documentation</a>
        </div>
      </div>
    </div>
  </section>
</Base>
