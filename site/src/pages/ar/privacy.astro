---
import Base from '../../layouts/Base.astro';
import SimplePageBody from '../../components/SimplePageBody.astro';
import { privacyPage } from '../../data/legal';
import { SITE_URL } from '../../lib/site';
import { breadcrumbSchema, webPageSchema } from '../../lib/schema';

const url = `${SITE_URL}/ar/privacy`;
const schema = [
  webPageSchema({
    name: 'الخصوصية',
    description: 'بلا حسابات ولا كوكيز ولا تتبع. ما يسجّله Cloudflare، وما لا يرسله الخادم، وكيف تعطّل فحص التحديث.',
    url,
    lang: 'ar',
  }),
  breadcrumbSchema([
    { name: 'الرئيسية', url: `${SITE_URL}/ar` },
    { name: 'الخصوصية', url },
  ]),
];
---

<Base
  lang="ar"
  title="الخصوصية: بلا كوكيز ولا تتبع"
  description="لا يضع هذا الموقع كوكيز ولا يطلب بيانات شخصية. يقدّمه Cloudflare ويسجّل بيانات طلب مجمّعة، ولا يرسل الخادم أي قياسات."
  path="/privacy"
  arPath="/ar/privacy"
  schema={schema}
>
  <SimplePageBody lang="ar" page={privacyPage.ar} crumb="الخصوصية" />
</Base>