---
import Base from '../../layouts/Base.astro';
import SimplePageBody from '../../components/SimplePageBody.astro';
import { licensePage } from '../../data/legal';
import { GITHUB_URL, SITE_URL } from '../../lib/site';
import { breadcrumbSchema, webPageSchema } from '../../lib/schema';

const url = `${SITE_URL}/ar/license`;
const schema = [
  webPageSchema({ name: 'الرخصة', description: 'GPL-3.0-or-later: الحريات والالتزامات والمكوّن المضمّن برخصة MIT.', url, lang: 'ar' }),
  breadcrumbSchema([
    { name: 'الرئيسية', url: `${SITE_URL}/ar` },
    { name: 'الرخصة', url },
  ]),
];
---

<Base
  lang="ar"
  title="الرخصة — GPL-3.0-or-later"
  description="Orbiscreen برنامج حر تحت GPL-3.0-or-later: شغّله وادرسه وشاركه وعدّله، مع بقاء الأعمال المشتقة تحت الرخصة نفسها."
  path="/license"
  arPath="/ar/license"
  schema={schema}
>
  <SimplePageBody lang="ar" page={licensePage.ar} crumb="الرخصة">
    <p>
      <a href="https://www.gnu.org/licenses/gpl-3.0.html" rel="noopener">اقرأ نص GPL-3.0 الكامل</a>
      {' · '}
      <a href={`${GITHUB_URL}/blob/main/LICENSE`} rel="noopener">ملف LICENSE في المستودع</a>
    </p>
  </SimplePageBody>
</Base>