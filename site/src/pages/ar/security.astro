---
import Base from '../../layouts/Base.astro';
import SimplePageBody from '../../components/SimplePageBody.astro';
import { securityPage } from '../../data/legal';
import { ADVISORY_URL, GITHUB_URL, SITE_URL } from '../../lib/site';
import { breadcrumbSchema, webPageSchema } from '../../lib/schema';

const url = `${SITE_URL}/ar/security`;
const schema = [
  webPageSchema({
    name: 'سياسة الأمان',
    description: 'كيف تبلّغ عن ثغرة في Orbiscreen بخصوصية، وما يشمله النطاق، وأي الإصدارات تتلقى التحديثات.',
    url,
    lang: 'ar',
  }),
  breadcrumbSchema([
    { name: 'الرئيسية', url: `${SITE_URL}/ar` },
    { name: 'الأمان', url },
  ]),
];
---

<Base
  lang="ar"
  title="الأمان — أبلغ عن ثغرة"
  description="أبلغ عن ثغرات Orbiscreen بخصوصية عبر استشارات GitHub أو البريد. ويشمل النطاق المصادقة وملكية الجلسة وحقن الإدخال والتغليف."
  path="/security"
  arPath="/ar/security"
  schema={schema}
>
  <SimplePageBody lang="ar" page={securityPage.ar} crumb="الأمان">
    <p>
      <a href={ADVISORY_URL} rel="noopener">افتح استشارة أمان خاصة</a>
      {' · '}
      <a href={`${GITHUB_URL}/blob/main/SECURITY.md`} rel="noopener">SECURITY.md</a>
    </p>
  </SimplePageBody>
</Base>