{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbiscreen",
  "version": "0.25.6",
  "identifier": "orbiscreen-gui",
  "build": {
    "frontendDist": "./ui"
  },
  "bundle": {
    "icon": [
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Orbiscreen",
        "width": 800,
        "height": 620,
        "minWidth": 680,
        "minHeight": 520,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
