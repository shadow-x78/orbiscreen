{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbiscreen",
  "version": "0.27.1",
  "identifier": "orbiscreen-gui",
  "build": {
    "frontendDist": "./ui"
  },
  "bundle": {
    "icon": [
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Orbiscreen",
        "width": 540,
        "height": 680,
        "minWidth": 480,
        "minHeight": 580,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  }
}
