{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbiscreen",
  "version": "0.25.4",
  "identifier": "com.orbiscreen.gui",
  "build": {
    "frontendDist": "./ui"
  },
  "bundle": {
    "icon": [
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Orbiscreen",
        "width": 760,
        "height": 580,
        "minWidth": 620,
        "minHeight": 460,
        "width": 560,
        "height": 620,
        "minWidth": 500,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; img-src 'self' blob: data:; connect-src 'self' ipc: http://127.0.0.1:*;"
    }
  }
}
