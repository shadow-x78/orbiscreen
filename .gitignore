# ─────────────────────────────────────────────
# Orbiscreen - Git Ignore Rules
# https://github.com/shadow-x78/orbiscreen
# ─────────────────────────────────────────────

# ── Rust / Cargo ──
/target/
**/*.rs.bk
Cargo.lock.bak
.cargo/

# ── Build artifacts ──
/dist/
*.deb
*.rpm
*.AppImage
*.apk
*.aab
*.ap_
*.dex
*.class

# ── Gradle (Android) ──
.gradle/
**/build/
captures/
.cxx/
.kotlin/

# ── Local secrets / keystores ──
*.keystore
*.jks
local.properties
google-services.json

# ── Editor artifacts ──
.vscode/
.idea/
*.swp
*.sublime-*
.playwright-mcp/

# ── OS files ──
.DS_Store
Thumbs.db

# ── Logs / coverage ──
*.log
coverage/
*.lcov
