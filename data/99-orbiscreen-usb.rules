# Orbiscreen - Android Open Accessory (AOA) & Android USB device rules
# Allows unprivileged user access for direct USB streaming without root or ADB
SUBSYSTEM=="usb", ATTR{idVendor}=="18d1", ATTR{idProduct}=="2d0[0145]", MODE="0666", TAG+="uaccess"
SUBSYSTEM=="usb", ATTR{idVendor}=="18d1", MODE="0666", TAG+="uaccess"
