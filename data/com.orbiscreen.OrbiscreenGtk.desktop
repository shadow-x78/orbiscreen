# ─────────────────────────────────────────────
# Orbiscreen - Desktop Entry (GTK Control Panel)
# https://github.com/shadow-x78/orbiscreen
# ─────────────────────────────────────────────

[Desktop Entry]
Name=Orbiscreen Secondary Display
Comment=Virtual secondary displays for Linux streamed to Android devices over Wi-Fi or USB
Exec=orbiscreen-gtk
Icon=com.orbiscreen.OrbiscreenGtk
Terminal=false
Type=Application
Categories=Utility;GTK;GNOME;
Keywords=display;virtual;monitor;android;spacedesk;streaming;
StartupNotify=true
